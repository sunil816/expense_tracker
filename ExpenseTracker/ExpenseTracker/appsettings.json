{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DocumentExtraction": {
    "BaseUrl": "https://localhost:5001",
    "SubmitPath": "/v1/convert/file/async",
    "StatusPathTemplate": "/v1/status/poll/{task_id}",
    "ResultPathTemplate": "/v1/result/{task_id}",
    "HttpTimeoutSeconds": 120,
    "ExtractionDeadlineSeconds": 900,
    "PollIntervalSeconds": 2,
    "PollRetryAttempts": 3,
    "PollRetryBackoffMilliseconds": 250,
    "MaximumFileSizeBytes": 26214400,
    "MaximumResponseSizeBytes": 52428800,
    "FileFieldName": "files",
    "Headers": {},
    "ConversionOptions": {},
    "MaximumConcurrentExtractions": 2
  },
  "AllowedHosts": "*"
}
